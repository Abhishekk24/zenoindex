    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050706",
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-mono.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.zeno.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050706",
          "image": "./assets/images/zeno-icon.png",
          "imageWidth": 78,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Zeno uses your photos so you can choose an image for a basket you create.",
