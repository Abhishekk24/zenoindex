{
  "expo": {
    "name": "Zeno",
    "slug": "zeno-mobile",
    "scheme": "zeno",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050706",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zeno.mobile",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "metamask",
          "trust",
          "rainbow",
          "cbwallet",
          "okx",
          "zerion",
          "uniswap",
          "rabby",
          "phantom",
          "ledgerlive",
          "exodus",
          "imtokenv2",
          "wc"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050706",
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-mono.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.zeno.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050706",
          "image": "./assets/images/zeno-icon.png",
          "imageWidth": 78,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Zeno uses your photos so you can choose an image for a basket you create.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/withWalletQueries"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
