DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/zenoindex
# Optional: a private/keyed Robinhood mainnet RPC (never sent to clients; /chains always returns the public RPC)
RPC_URL=https://rpc.mainnet.chain.robinhood.com
PORT=8787
NODE_ENV=development
# Privy (mobile email / Google sign-in). App ID is public; the secret must never ship in the app.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
